# Copiar como .env y rellenar. El .env NUNCA se sube al repositorio.

# Canvas LMS
CANVAS_URL=https://utpl.test.instructure.com
CANVAS_TOKEN=
CANVAS_ACCOUNT_ID=1

# Proveedores de IA
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Rutas del monorepo
RUTA_PLANTILLAS=./packages/plantillas
RUTA_CANON=./packages/canon

# Base de datos
DATABASE_URL=postgresql+psycopg://ediloja:ediloja_local@localhost:5432/ediloja
REDIS_URL=redis://localhost:6379/0

# Seguridad (genera una nueva con: openssl rand -hex 32)
JWT_SECRET=cambiame
JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS=480
